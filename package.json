{
  "name": "geoviewer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Web-based well log (LAS) viewer and correlation tool — a Petrel-alternative starting point",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
